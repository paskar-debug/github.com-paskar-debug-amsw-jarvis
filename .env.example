# --- Supabase ---
# Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key - kun til brug i botten (server-side), aldrig i dashboardets browser-kode
SUPABASE_SERVICE_ROLE_KEY=
# Auth -> Users: uuid for din egen bruger. Botten saetter denne som owner_id paa alle raekker,
# og RLS-policies sikrer at kun denne bruger (logget ind i dashboardet) kan se dem.
SUPABASE_OWNER_USER_ID=

# --- Telegram ---
# Opret bot via @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Din egen Telegram user-id (fra @userinfobot) - botten ignorerer alle andre afsendere
TELEGRAM_ALLOWED_USER_ID=

# --- Tale-til-tekst (til stemmebeskeder ind) ---
# Bruges til at transskribere Telegram voice-notes (OpenAI Whisper API)
OPENAI_API_KEY=

# --- Tekst-til-tale (til stemmesvar ud) ---
# "openai" (bruger samme OPENAI_API_KEY, model tts-1) eller "elevenlabs"
TTS_PROVIDER=openai
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Klassificering (opgave vs. kalenderaftale) ---
# console.anthropic.com -> API Keys. Separat fra OPENAI_API_KEY ovenfor.
# Uden denne bliver alle beskeder bare til opgaver (samme opførsel som før).
ANTHROPIC_API_KEY=

# --- Google Calendar ---
# Google Cloud Console -> OAuth 2.0 Client (Desktop app) + Calendar API enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:53682/oauth2callback
# Udfyldes automatisk af scripts/google-auth.ts efter første login
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Todoist ---
# https://app.todoist.com/app/settings/integrations/developer
TODOIST_API_TOKEN=

# --- Shopify ---
# Admin API access token fra en custom app i din Shopify-butik
SHOPIFY_STORE_DOMAIN=din-butik.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_VERSION=2024-10

# --- Infrastruktur-status (plan/forbrug for platformene selv, ikke forretnings-data) ---
# Supabase: dashboard.supabase.com/account/tokens (Personal Access Token)
SUPABASE_ACCESS_TOKEN=
# Vercel: vercel.com/account/tokens
VERCEL_API_TOKEN=
VERCEL_PROJECT_NAME=amsw
# Railway: railway.app/account/tokens
RAILWAY_API_TOKEN=

# --- Dashboard (Next.js, offentlige vars skal have NEXT_PUBLIC_ praefiks) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
