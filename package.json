{
  "name": "amsw-jarvis",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bot:dev": "npm run dev --workspace=@amsw/bot",
    "bot:build": "npm run build --workspace=@amsw/bot",
    "bot:start": "npm run start --workspace=@amsw/bot",
    "dashboard:dev": "npm run dev --workspace=@amsw/dashboard",
    "dashboard:build": "npm run build --workspace=@amsw/dashboard",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
